    margin: 40px auto;
    border-radius: 50%;
    border: 6px solid #333;
    position: relative;
    transition: transform 4s cubic-bezier(0.17, 0.67, 0.32, 1.4);
    /* transform gets set by JS when we spin - this transition is what
       makes it visually "ease out" instead of snapping instantly */
  }

  /* A little pointer fixed above the wheel so you can see what it landed on */
  #pointer {
    width: 0; height: 0;
    border-left: 15px solid transparent;
